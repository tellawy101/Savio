const addBtn = document.getElementById("addBtn");
console.log(addBtn);
const modal = document.getElementById("expenseModal");
const closeBtn = document.getElementById("closeBtn");
const saveBtn = document.getElementById("saveBtn");

const incomeBtn = document.getElementById("incomeBtn");
const incomeModal = document.getElementById("incomeModal");
const incomeAmount = document.getElementById("incomeAmount");
const saveIncomeBtn = document.getElementById("saveIncomeBtn");
const closeIncomeBtn = document.getElementById("closeIncomeBtn");

const amount = document.getElementById("amount");
const category = document.getElementById("category");

const expenseList = document.getElementById("expenseList");
const searchInput = document.getElementById("searchInput");
const totalExpense = document.getElementById("totalExpense");
const totalIncome = document.getElementById("totalIncome");
const balance = document.getElementById("balance");
const addMenuBtn = document.getElementById("addMenuBtn");
const fabMenu = document.getElementById("fabMenu");
const fabIncome = document.getElementById("fabIncome");
const fabExpense = document.getElementById("fabExpense");
// تحميل البيانات
let expenses = JSON.parse(localStorage.getItem("expenses")) || [];
let income = Number(localStorage.getItem("income")) || 0;

let total = 0;
let editIndex = -1;

// غلق نافذة المصروف
closeBtn.onclick = () => {
    modal.style.display = "none";
};
// غلق نافذة الدخل
closeIncomeBtn.onclick = () => {
    incomeModal.style.display = "none";
};

// عرض البيانات
function renderExpenses() {
    console.log(expenses);
    expenseList.innerHTML = "";
    total = 0;
    
    expenses.forEach((expense, index) => {

    if (
        !expense.category
            .toLowerCase()
            .includes(searchInput.value.toLowerCase())
    ) {
        return;
    }
        
        total += expense.amount;
        
        const li = document.createElement("li");
        
        li.innerHTML = `
    <div>
        <strong>${expense.category}</strong><br>
        EGP ${expense.amount}<br>
        📅 ${expense.date}<br>
        🕒 ${expense.time}
    </div>

    <div>
        <button class="editBtn">✏️</button>
        <button class="deleteBtn">🗑</button>
    </div>
`;
        li.querySelector(".editBtn").onclick = () => {

    amount.value = expense.amount;
    category.value = expense.category;

    editIndex = index;

    modal.style.display = "flex";

};
        li.querySelector(".deleteBtn").onclick = () => {

    if (confirm("Delete this expense?")) {

        expenses.splice(index, 1);

        localStorage.setItem("expenses", JSON.stringify(expenses));

        renderExpenses();

    }

};
        
        expenseList.appendChild(li);
        
    });
    
    totalExpense.innerText = "EGP " + total.toFixed(2);
    totalIncome.innerText = "EGP " + income.toFixed(2);
    balance.innerText = "EGP " + (income - total).toFixed(2);
    
}

// حفظ المصروف
saveBtn.onclick = () => {
    
    if (amount.value === "") {
        alert("Please enter an amount.");
        return;
    }
    
    const now = new Date();
    
    const expenseData = {
    amount: Number(amount.value),
    category: category.value,
    date: now.toLocaleDateString(),
    time: now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit"
    })
};

if (editIndex === -1) {
    expenses.push(expenseData);
} else {
    expenses[editIndex] = expenseData;
    editIndex = -1;
}
    
    localStorage.setItem("expenses", JSON.stringify(expenses));
    
    renderExpenses();
    
    amount.value = "";
    category.selectedIndex = 0;
    editIndex = -1;
    
    modal.style.display = "none";
    
};

// حفظ الدخل
saveIncomeBtn.onclick = () => {
    const now = new Date();

expenses.push({
    amount: Number(incomeAmount.value),
    category: "💰 Income",
    date: now.toLocaleDateString(),
    time: now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit"
    })
});

localStorage.setItem("expenses", JSON.stringify(expenses));
    if (incomeAmount.value === "") {
        alert("Please enter income.");
        return;
    }
    
    income += Number(incomeAmount.value);
    
    localStorage.setItem("income", income);
    
    incomeAmount.value = "";
    
    incomeModal.style.display = "none";
    
    renderExpenses();
    
};

// // تشغيل التطبيق
renderExpenses();

if (searchInput) {
    searchInput.addEventListener("input", renderExpenses);
}
const themeBtn = document.getElementById("themeBtn");

// تحميل الوضع المحفوظ
if (localStorage.getItem("theme") === "dark") {
    document.body.classList.add("dark");
    themeBtn.innerText = "☀️ Light Mode";
}

themeBtn.onclick = () => {

    document.body.classList.toggle("dark");

    if (document.body.classList.contains("dark")) {
        localStorage.setItem("theme", "dark");
        themeBtn.innerText = "☀️";
    } else {
        localStorage.setItem("theme", "light");
        themeBtn.innerText = "🌙";
    }

};
addMenuBtn.onclick = function () {

    if (fabMenu.classList.contains("show")) {
        fabMenu.classList.remove("show");
        addMenuBtn.classList.remove("open");
    } else {
        fabMenu.classList.add("show");
        addMenuBtn.classList.add("open");
    }

};
fabIncome.onclick = function () {
    fabMenu.classList.remove("show");
    addMenuBtn.classList.remove("open");
    incomeModal.style.display = "flex";
};

fabExpense.onclick = function () {
    fabMenu.classList.remove("show");
    addMenuBtn.classList.remove("open");
    modal.style.display = "flex";
};
